# Cortex AI - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Platform Configuration
# =============================================================================
# Choose one: local, snowflake, databricks
DEPLOYMENT_PLATFORM=local

# =============================================================================
# Logging Configuration
# =============================================================================
# Enable debug mode (true/false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Use structured JSON logging (recommended for production)
STRUCTURED_LOGGING=false

# Log file path (optional)
LOG_FILE=logs/cortex_ai.log

# Enable platform log shipping (Snowflake/Databricks tables)
ENABLE_PLATFORM_LOGGING=false

# =============================================================================
# Snowflake Configuration (if DEPLOYMENT_PLATFORM=snowflake)
# =============================================================================
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CORTEX_AI
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# =============================================================================
# Databricks Configuration (if DEPLOYMENT_PLATFORM=databricks)
# =============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default

# =============================================================================
# Optional: External Services
# =============================================================================
# ChromaDB (for local vector search)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# PostgreSQL (for persistent storage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cortex_ai
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_password

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Application Configuration
# =============================================================================
# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Enable/disable features
ENABLE_AGENT_BUILDER=true
ENABLE_WORKFLOW_BUILDER=true
ENABLE_KNOWLEDGE_BASE=true
ENABLE_PLATFORM_TOOLS=true

# Default model settings
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# =============================================================================
# Security
# =============================================================================
# Enable authentication (future feature)
ENABLE_AUTH=false

# Allowed domains for CORS
ALLOWED_DOMAINS=localhost,127.0.0.1

# Session timeout (minutes)
SESSION_TIMEOUT=60

# =============================================================================
# Performance
# =============================================================================
# Max concurrent workflow executions
MAX_CONCURRENT_WORKFLOWS=5

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Cache TTL (seconds)
CACHE_TTL=3600
